{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "医保项目目录映射领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CATALOG_PUBLISHED",
        "MAPPING_PROPOSED",
        "MAPPING_REVIEWED",
        "SNAPSHOT_FROZEN",
        "CORRECTION_RELEASED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "catalog_revision",
        "service_item",
        "mapping_claim",
        "settlement_snapshot"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
